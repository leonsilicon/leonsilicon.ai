{
  "name": "leonsilicon.ai",
  "version": "0.1.0",
  "private": true,
  "description": "Leon's AI setup in public: what runs on leonsilicon.ai and its subdomains, organized as a Flatcap workspace.",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/**",
      "www/**"
    ],
    "catalog": {
      "@krzysztofkobra/orca-mcp": "0.1.1",
      "@modelcontextprotocol/sdk": "1.32.2",
      "@todoist/automations-cli": "2.2.0",
      "@types/node": "24.19.2",
      "@varlock/cloudflare-integration": "1.6.3",
      "@varlock/infisical-plugin": "2.1.3",
      "eslint-plugin-flatcap": "0.1.0",
      "openai": "7.45.1",
      "typescript": "7.0.2",
      "varlock": "1.24.0",
      "vite-plus": "1.5.0",
      "wrangler": "4.158.0",
      "yaml": "2.9.1",
      "zod": "4.6.7"
    }
  },
  "type": "module",
  "scripts": {},
  "devDependencies": {
    "@-/ai.leonsilicon.configs.env-file": "workspace:*",
    "@-/ai.leonsilicon.configs.patching.generator": "workspace:*",
    "@-/ai.leonsilicon.configs.todoist-automations": "workspace:*",
    "@types/node": "catalog:",
    "@varlock/cloudflare-integration": "catalog:",
    "@varlock/infisical-plugin": "catalog:",
    "eslint-plugin-flatcap": "catalog:",
    "typescript": "catalog:",
    "varlock": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
