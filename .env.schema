# leonsilicon.ai environment schema: https://varlock.dev/env-spec
#
# This repository is public. Anything private lives in Infisical, not here: secrets, and also
# identifiers such as Slack IDs, tailnet hosts and IPs, usernames and private paths. Each app's
# values are in an Infisical folder named after the app, and values more than one app uses are in /shared.
#
# Every item is tagged with the app that uses it, and an app only ever loads its own tag (a filtered
# load resolves nothing else):
#   #slack-as-leon      Worker vars and secrets, uploaded by `vpr -w deploy:slack-as-leon`
#   #slack22linear     Worker vars and secrets, uploaded by `vpr -w deploy:slack22linear`
#   #autolinear         Worker vars and secrets, uploaded by `vpr -w deploy:autolinear`. It shares Leon's Slack
#                       session and the Linear key with #slack22linear.
#   #dailylinear        Worker vars and secrets, uploaded by `vpr -w deploy:dailylinear`. It shares Leon's Slack
#                       session, Hermes's user ID, the Linear key and the sidebar sections with #slack22linear.
#                       (all three run varlock-wrangler from the app's directory, whose package.json sets the filter)
#   #orca-bridge        The Orca bridge on the mini, stopped 2026-11-21 (~/.config/orca-bridge/env there)
#   #gmail-feed         Worker vars and secrets, uploaded by `vpr -w deploy:gmail-feed`
#   #beeper-feed        Hermes Cloud feed settings, rendered by `vpx _env-file beeper-feed`
#   #slack22grokbot     Hermes Cloud Grok task-thread bridge settings
#   #cronometer         Worker vars and secrets, uploaded by `vpr -w deploy:cronometer` (varlock-wrangler too)
#   #grok-bot-roster    Worker vars and secrets, uploaded by `vpr -w deploy:grok-bot-roster` (varlock-wrangler too)
#   #hermes-thread      The Codex token, which `vpx varlock run --filter '#hermes-thread'` hands the installer in
#                       configs/silicon-dot/hermes-thread; it keeps it in the MacBook's login Keychain
#   #todoist-automations  The Todoist token and the values manifests refer to as { "$env": NAME }, read by
#                       `vpx _todoist-automations`, which the Deploy workflow runs as `push --yes`
#
# Infisical access: the project's Machine Identity `leonsilicon.com-repo` (Universal Auth; named before the move to
# leonsilicon.ai), whose
# client ID and secret go in `.env` (gitignored) next to this file.
#
# @defaultRequired=infer @defaultSensitive=false
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   id=leonsilicon,
#   projectId=babf5738-a1eb-4b70-8d6f-a29623322803,
#   environment=$INFISICAL_ENVIRONMENT,
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET
# )
# ---

# @type=infisicalClientId
INFISICAL_CLIENT_ID=
# @type=infisicalClientSecret @sensitive @internal
INFISICAL_CLIENT_SECRET=
# Infisical environment slug.
INFISICAL_ENVIRONMENT=prod

# ── Shared ─────────────────────────────────────────────────────────────────────────────────────────

# Leon's Slack web session: the web client's xoxc- token and the same session's `d` cookie. Every
# Worker that acts as Leon holds this one login.
# @tag(slack-as-leon, slack22linear, autolinear, dailylinear) @sensitive
SLACK_SESSION_TOKEN=infisical(leonsilicon, "SLACK_SESSION_TOKEN", "/shared")
# @tag(slack-as-leon, slack22linear, autolinear, dailylinear) @sensitive
SLACK_SESSION_COOKIE=infisical(leonsilicon, "SLACK_SESSION_COOKIE", "/shared")
# Leon's and Hermes's Slack user IDs.
# @tag(slack22linear, autolinear) @sensitive={allowShortValue=true}
SLACK_LEON_USER_ID=infisical(leonsilicon, "SLACK_LEON_USER_ID", "/shared")
# @tag(slack22linear, autolinear, dailylinear, slack22grokbot) @sensitive={allowShortValue=true}
SLACK_HERMES_USER_ID=infisical(leonsilicon, "SLACK_HERMES_USER_ID", "/shared")

# ── slack-as-leon (Cloudflare Worker, https://slack-puppet.leonsilicon.ai) ─────────────────────
# Uploaded as Worker secrets (sensitive) and vars (the rest). A deploy replaces every var and secret
# the Worker has, so anything set by hand with `wrangler secret put` is removed.

# Bearer token Hermes sends: `openssl rand -hex 32` (40+ characters).
# @tag(slack-as-leon, slack22grokbot) @sensitive
SLACK_AS_LEON_MCP_TOKEN=infisical(leonsilicon, "SLACK_AS_LEON_MCP_TOKEN", "/slack-as-leon")
# Comma-separated Slack user IDs nobody may DM or mention through it (Silicon Dot).
# @tag(slack-as-leon) @sensitive={allowShortValue=true}
SLACK_AS_LEON_BLOCKED_USERS=infisical(leonsilicon, "SLACK_AS_LEON_BLOCKED_USERS", "/slack-as-leon")
# @tag(slack-as-leon, slack22grokbot) @type=url
SLACK_AS_LEON_PUBLIC_ORIGIN=https://slack-puppet.leonsilicon.ai
# Most posts per rolling hour.
# @tag(slack-as-leon) @type=number
SLACK_AS_LEON_MAX_PER_HOUR=30
# Bearer token Leon's Grok Bot bots send (in Grok Bot's account-wide MCP config, server slack-puppet). It
# gets only hermes_thread_send/read: replies in a channel thread, labelled, so Hermes answers them.
# @tag(slack-as-leon) @sensitive
SLACK_AS_LEON_GROK_TOKEN=infisical(leonsilicon, "SLACK_AS_LEON_GROK_TOKEN", "/slack-as-leon")
# Most posts per rolling hour from Grok bots, counted apart from Hermes's.
# @tag(slack-as-leon) @type=number
SLACK_AS_LEON_GROK_MAX_PER_HOUR=120
# Bearer token the Codex sessions Silicon Dot starts on Leon's MacBook send (through the local
# hermes-thread MCP proxy, which keeps it in the login Keychain). Same tools as the Grok bots' token.
# @tag(slack-as-leon, hermes-thread) @sensitive
SLACK_AS_LEON_CODEX_TOKEN=infisical(leonsilicon, "SLACK_AS_LEON_CODEX_TOKEN", "/slack-as-leon")
# Most posts per rolling hour from Codex sessions.
# @tag(slack-as-leon) @type=number
SLACK_AS_LEON_CODEX_MAX_PER_HOUR=120

# ── grok-bot-roster (Cloudflare Worker, https://grokbot-admin.leonsilicon.ai) ────────────────────
# Uploaded as Worker secrets (sensitive) and vars (the rest), replacing whatever the Worker had. Leon's
# Grok Bot sign-in isn't here: it lives in the Worker's KV and refreshes itself (see its README).

# Bearer token Grok Bot sends as the custom MCP server's Authorization header: `openssl rand -hex 32`.
# @tag(grok-bot-roster, slack22grokbot) @sensitive
GROK_BOT_ROSTER_MCP_TOKEN=infisical(leonsilicon, "GROK_BOT_ROSTER_MCP_TOKEN", "/grok-bot-roster")
# @tag(grok-bot-roster, slack22grokbot) @type=url
GROK_BOT_ROSTER_PUBLIC_ORIGIN=https://grokbot-admin.leonsilicon.ai

# ── orca-bridge (Mac mini; stopped 2026-11-21, and its public address is gone) ─────────────────

# Bearer token Hermes sends: `openssl rand -hex 32`.
# @tag(orca-bridge) @sensitive
ORCA_BRIDGE_TOKEN=infisical(leonsilicon, "ORCA_BRIDGE_TOKEN", "/orca-bridge")
# Repo roots the orca-mcp worker tools may use, colon-separated (paths on the mini).
# @tag(orca-bridge) @sensitive
ORCA_MCP_ROOTS=infisical(leonsilicon, "ORCA_MCP_ROOTS", "/orca-bridge")
# @tag(orca-bridge) @type=port
ORCA_BRIDGE_PORT=18787
# @tag(orca-bridge) @type=url
ORCA_BRIDGE_PUBLIC_ORIGIN=https://orca.leonsilicon.ai
# Saved Orca environments `--environment` may name (comma-separated); without one, calls go to the mini.
# @tag(orca-bridge)
ORCA_BRIDGE_ENVIRONMENTS=MacBook
# Stays under Hermes Cloud's 180 s MCP timeout.
# @tag(orca-bridge) @type=number
ORCA_BRIDGE_MAX_CALL_MS=170000
# Owner tag on the workers the orca-mcp tools start.
# @tag(orca-bridge)
ORCA_MCP_CLIENT=hermes-cloud

# ── gmail-feed (Cloudflare Worker, https://gmail-feed.leonsilicon.ai) ───────────────────────────
# Copies every email that reaches Leon's Gmail into the #feed- channels. A deploy replaces every var
# and secret the Worker had.

# Slack bot token (xoxb-) for Gmail Feed and Beeper Feed.
# @tag(gmail-feed, beeper-feed) @sensitive
SLACK_BOT_TOKEN=infisical(leonsilicon, "SLACK_BOT_TOKEN", "/gmail-feed")
# The Decisions API key for screening feed messages.
# @tag(gmail-feed, beeper-feed) @sensitive
OPENAI_API_KEY=infisical(leonsilicon, "OPENAI_API_KEY", "/gmail-feed")
# Hermes's Slack user ID, mentioned when a message needs its attention.
# @tag(gmail-feed) @sensitive={allowShortValue=true}
HERMES_SLACK_USER_ID=$SLACK_HERMES_USER_ID
# Slack user IDs added to the feed channel when the bot creates it, besides Hermes (comma-separated).
# @tag(gmail-feed, beeper-feed) @sensitive={allowShortValue=true}
FEED_INVITE=infisical(leonsilicon, "FEED_INVITE", "/gmail-feed")
# Channel IDs (or names) where unsafe feed messages and spam are held.
# @tag(gmail-feed, beeper-feed) @sensitive={allowShortValue=true}
FEED_FLAGGED_CHANNEL=infisical(leonsilicon, "FEED_FLAGGED_CHANNEL", "/gmail-feed")
# @tag(gmail-feed, beeper-feed) @sensitive={allowShortValue=true}
FEED_SPAM_CHANNEL=infisical(leonsilicon, "FEED_SPAM_CHANNEL", "/gmail-feed")

# The OAuth client and refresh token of the read-only Gmail grant Hermes uses too (Leon's Internal
# Google Cloud app, gmail.readonly only, so the token doesn't expire weekly).
# @tag(gmail-feed) @sensitive
GMAIL_FEED_GOOGLE_CLIENT_ID=infisical(leonsilicon, "GMAIL_FEED_GOOGLE_CLIENT_ID", "/gmail-feed")
# @tag(gmail-feed) @sensitive
GMAIL_FEED_GOOGLE_CLIENT_SECRET=infisical(leonsilicon, "GMAIL_FEED_GOOGLE_CLIENT_SECRET", "/gmail-feed")
# @tag(gmail-feed) @sensitive
GMAIL_FEED_GOOGLE_REFRESH_TOKEN=infisical(leonsilicon, "GMAIL_FEED_GOOGLE_REFRESH_TOKEN", "/gmail-feed")
# Bearer token for /admin/* (status, tick, backfill): `openssl rand -hex 32`.
# @tag(gmail-feed) @sensitive
GMAIL_FEED_ADMIN_TOKEN=infisical(leonsilicon, "GMAIL_FEED_ADMIN_TOKEN", "/gmail-feed")
# The channel safe emails go to, created by the bot when missing.
# @tag(gmail-feed)
GMAIL_FEED_CHANNEL=feed-gmail
# screened: wake Hermes when the screener says it should know | none: never. Replaces Hermes's old
# 30-minute Gmail monitor cron (deleted 2026-11-19 with Leon's other cron jobs).
# @tag(gmail-feed) @type=enum(screened, none)
GMAIL_FEED_WAKE=screened
# The wake question's threshold for email. The screener scores most notifications 0.8 or more; against
# the old monitor's 272 alerts (2026-11-19, 218 recent emails, AUC 0.83), 0.9 caught 80% of them and
# would wake Hermes for about 27% of mail; 0.95 caught 62% at 15%.
# @tag(gmail-feed) @type=number
GMAIL_FEED_WAKE_THRESHOLD=0.9
# Held in #feed-flagged when the unsafe reasons add up to this. Beeper's 0.3 held 16 of 225 real emails
# (bank, Apple, Google and e-transfer notices that pass DMARC); 0.7 held 2, and synthetic phishing, scam,
# credential and AI-injection emails scored 0.97 to 1.00 (2026-11-19).
# @tag(gmail-feed) @type=number
GMAIL_FEED_UNSAFE_THRESHOLD=0.7

# ── slack22linear (Cloudflare Worker, https://linear-slack.leonsilicon.ai) ────────────────
# Uses the shared Slack session and user IDs too. A deploy replaces every var and secret the Worker had.
# App-specific values live in the existing /linear-slack-sync Infisical folder.

# Personal API key of the Linear account the sync acts as. autolinear creates issues with it too, and
# dailylinear the day's projects.
# @tag(slack22linear, autolinear, dailylinear) @sensitive
LINEAR_API_KEY=infisical(leonsilicon, "LINEAR_API_KEY", "/linear-slack-sync")
# Signing secret of the Linear webhook.
# @tag(slack22linear) @sensitive
LINEAR_WEBHOOK_SECRET=infisical(leonsilicon, "LINEAR_WEBHOOK_SECRET", "/linear-slack-sync")
# Bot token (xoxb-) and signing secret of the "Linear Sync" Slack app.
# @tag(slack22linear) @sensitive
LINEAR_SYNC_SLACK_BOT_TOKEN=infisical(leonsilicon, "LINEAR_SYNC_SLACK_BOT_TOKEN", "/linear-slack-sync")
# @tag(slack22linear) @sensitive
LINEAR_SYNC_SLACK_SIGNING_SECRET=infisical(leonsilicon, "LINEAR_SYNC_SLACK_SIGNING_SECRET", "/linear-slack-sync")
# Bearer token for /admin/* (status, backfill, tick).
# @tag(slack22linear) @sensitive
LINEAR_SYNC_ADMIN_TOKEN=infisical(leonsilicon, "LINEAR_SYNC_ADMIN_TOKEN", "/linear-slack-sync")
# Read-only bearer for the Beeper inbox's Linear issue metadata publisher.
# @tag(slack22linear, linear-issue-metadata) @sensitive @optional
LINEAR_ISSUE_METADATA_TOKEN=fallback(infisical(leonsilicon, "LINEAR_ISSUE_METADATA_TOKEN", "/linear-slack-sync", allowMissing=true), undefined)
# @tag(slack22linear) @type=boolean
LINEAR_ISSUE_METADATA_MATRIX_ONLY=true
# Linear team whose issues and projects get channels.
# @tag(slack22linear, autolinear, dailylinear)
LINEAR_TEAM_KEY=LEON
# Sidebar sections top to bottom, each named exactly after a Linear status.
# @tag(slack22linear, dailylinear)
SECTION_ORDER="Awaiting Leon,Awaiting Clarification,Awaiting Others,Awaiting Listener,Awaiting Hermes,Awaiting Init,Awaiting Start,Executing,Awaiting Date"
# The sidebar section for project channels (Linear's own project-… channels), below the status sections.
# dailylinear keeps the day's project channel in Starred instead, a day's made ahead of time here until its day,
# and archives past days' channels.
# @tag(slack22linear, dailylinear)
PROJECT_SECTION=Projects
# Statuses that mention Leon, and statuses that ping Hermes, when an issue moves into them.
# @tag(slack22linear)
MENTION_LEON_STATES="Awaiting Leon,Awaiting Clarification"
# @tag(slack22linear)
PING_HERMES_STATES="Awaiting Hermes,Awaiting Start"
# The public channel where issues coming due are announced. The sync creates it when missing.
# @tag(slack22linear)
LINEAR_FEED_CHANNEL=feed-linear

# ── autolinear (Cloudflare Worker, https://autolinear.leonsilicon.ai) ───────────────────────────
# Makes each of Leon's Slack messages a Linear issue with its own channel, for Hermes's autolinear
# plugin. Also uses the shared Slack session and user IDs, and slack22linear's Linear key and team.

# Bearer token Hermes's autolinear plugin sends: `openssl rand -hex 32`. Hermes holds the same value.
# @tag(autolinear, hermes) @sensitive
AUTOLINEAR_TOKEN=infisical(leonsilicon, "AUTOLINEAR_TOKEN", "/autolinear")
# The LEON team's ID and its Awaiting Init status's ID, and `https://<workspace>.slack.com`. They spare
# autolinear a lookup on a cold start; without them it looks them up once per isolate.
# @tag(autolinear) @optional
LINEAR_TEAM_ID=fallback(infisical(leonsilicon, "LINEAR_TEAM_ID", "/autolinear", allowMissing=true), undefined)
# @tag(autolinear) @optional
LINEAR_INTAKE_STATE_ID=fallback(infisical(leonsilicon, "LINEAR_INTAKE_STATE_ID", "/autolinear", allowMissing=true), undefined)
# @tag(autolinear) @optional
SLACK_WORKSPACE_URL=fallback(infisical(leonsilicon, "SLACK_WORKSPACE_URL", "/autolinear", allowMissing=true), undefined)
# The status new issues start in, Linear's default for the team.
# @tag(autolinear)
INTAKE_STATE="Awaiting Init"
# Signing secret of the autolinear Slack app, whose user events (Leon's messages in his DMs and public
# channels) start intakes before Hermes asks. Without it, autolinear waits for Hermes's call.
# @tag(autolinear) @sensitive @optional
AUTOLINEAR_SLACK_SIGNING_SECRET=fallback(infisical(leonsilicon, "AUTOLINEAR_SLACK_SIGNING_SECRET", "/autolinear", allowMissing=true), undefined)
# Leon's DM with Hermes, the one DM whose messages the app's events start on. Looked up when unset.
# @tag(autolinear) @sensitive={allowShortValue=true} @optional
SLACK_HERMES_DM_ID=fallback(infisical(leonsilicon, "SLACK_HERMES_DM_ID", "/autolinear", allowMissing=true), undefined)
# Channel IDs (comma-separated) whose messages Hermes answers where they are. Read by the Worker and
# by Hermes's autolinear plugin, so both leave the same channels alone.
# @tag(autolinear, hermes) @optional
AUTOLINEAR_SKIP_CHANNELS=
# The autolinear Slack app's bot, "Autolinear" (since 2026-11-23): Hermes ends every turn in an issue
# channel with a line mentioning it that says what to do with the channel, and slack22linear posts as
# it to remind Hermes when a turn ends without one. Hermes's plugin writes the mention from the user ID,
# and Hermes's SLACK_ALLOWED_USERS must list it, or Hermes ignores the reminders.
# @tag(slack22linear, hermes) @sensitive={allowShortValue=true}
AUTOLINEAR_BOT_USER_ID=infisical(leonsilicon, "AUTOLINEAR_BOT_USER_ID", "/autolinear")
# @tag(slack22linear) @sensitive
AUTOLINEAR_SLACK_BOT_TOKEN=infisical(leonsilicon, "AUTOLINEAR_SLACK_BOT_TOKEN", "/autolinear")

# ── dailylinear (Cloudflare Worker, https://dailylinear.leonsilicon.ai) ─────────────────────────
# Makes each day's Linear project at midnight in Toronto, with its project-YYYY-MM-DD channel starred.
# Also uses the shared Slack session and Hermes's user ID, and slack22linear's Linear key, team and sections.

# Bearer token for /admin/* (run, status): `openssl rand -hex 32`.
# @tag(dailylinear) @sensitive
DAILYLINEAR_ADMIN_TOKEN=infisical(leonsilicon, "DAILYLINEAR_ADMIN_TOKEN", "/dailylinear")

# ── todoist-automations (Todoist Automations, packages/ai/leonsilicon/configs/todoist-automations) ──
# Read by `vpx _todoist-automations`, never uploaded anywhere: the token signs tda in, and the rest
# stand in for { "$env": NAME } in the manifests.

# Personal API token of Leon's Todoist account (Settings → Integrations → Developer), for tda in the
# Deploy workflow. Optional on a Mac signed in with `tda auth login`, which tda uses first.
# @tag(todoist-automations) @sensitive @optional
TODOIST_API_TOKEN=fallback(infisical(leonsilicon, "TODOIST_API_TOKEN", "/todoist-automations", allowMissing=true), undefined)
# Leon's Linear user ID: the Linear→Todoist mirror only takes issues assigned to it.
# @tag(todoist-automations) @sensitive
LINEAR_LEON_USER_ID=infisical(leonsilicon, "LINEAR_LEON_USER_ID", "/shared")

# ── cronometer (Cloudflare Python Worker, https://cronometer.leonsilicon.ai) ───────────────────────
# Until 2026-11-21 these lived only in files on the Mac mini.

# Bearer token the Grok bots' Cronometer connector sends: `openssl rand -hex 32`.
# @tag(cronometer) @sensitive
CRONOMETER_HTTP_TOKEN=infisical(leonsilicon, "CRONOMETER_HTTP_TOKEN", "/cronometer")
# Leon's Cronometer login, from his password manager's "Cronometer" item. The account has no 2FA; if
# it gets one, add CRONOMETER_TOTP_SECRET the same way.
# @tag(cronometer) @sensitive
CRONOMETER_USERNAME=infisical(leonsilicon, "CRONOMETER_USERNAME", "/cronometer")
# @tag(cronometer) @sensitive
CRONOMETER_PASSWORD=infisical(leonsilicon, "CRONOMETER_PASSWORD", "/cronometer")
# The only Host the MCP endpoint answers to.
# @tag(cronometer)
CRONOMETER_HTTP_PUBLIC_HOST=cronometer.leonsilicon.ai

# ── Hermes Cloud (Captain Claude) ─────────────────────────────────────────────────────────────────
# Read by the autolinear plugin, with AUTOLINEAR_TOKEN above: Leon's Slack user ID, whose messages
# become issues. The plugin is off until both are set.
# @tag(hermes) @sensitive={allowShortValue=true}
AUTOLINEAR_USER_ID=$SLACK_LEON_USER_ID

# ── beeper-inbox (Hermes Cloud) ──────────────────────────────────────────────────────────────────
# Not loaded from Infisical: BEEPER_INBOX_ACCESS_TOKEN and BEEPER_INBOX_RECOVERY_KEY live only in Captain
# Claude's /opt/data/.env. The token belongs to one Matrix device; the recovery key's source is 1Password. The
# store's own key is generated beside the store, not in .env. See apps/beeper-inbox/README.md.

# ── agents-vault (Silicon Dot's 1Password access on Leon's MacBook) ───────────────────────────────

# op:// reference of the Private-vault backup of the service account token.
# @tag(agents-vault) @sensitive
AGENTS_VAULT_TOKEN_REF=infisical(leonsilicon, "AGENTS_VAULT_TOKEN_REF", "/agents-vault")
