{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "slack-as-leon",
  "main": "worker.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  // A Custom Domain per hostname; Cloudflare issues its certificate. slack-puppet is the name since
  // 2026-11-19; slack-as-leon stays only until Captain Claude has moved over (remove after 2026-11-26).
  "routes": [
    { "pattern": "slack-puppet.leonsilicon.ai", "custom_domain": true },
    { "pattern": "slack-as-leon.leonsilicon.ai", "custom_domain": true },
  ],
  "preview_urls": false,
  // The Vite build of www/ (vp build). The Worker runs first and serves a page only to browsers; see
  // @-/ai.leonsilicon.configs.cloudflare.
  "assets": {
    "directory": "../../dist/www",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  "kv_namespaces": [{ "binding": "RATE", "id": "62f151bf8e494860a63306319290ab8b" }],
  // No vars here: every var and secret comes from the root .env.schema (#slack-as-leon, values in
  // Infisical), uploaded by `varlock-wrangler deploy`, which replaces whatever the Worker had.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
