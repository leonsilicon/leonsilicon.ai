{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "cronometer",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-08",
  "compatibility_flags": ["python_workers"],
  "workers_dev": false,
  "preview_urls": false,
  // A Custom Domain; Cloudflare issues its certificate. Until 2026-11-21 this hostname belonged to the
  // ai-edge Worker (since removed), which forwarded it to the Mac mini.
  "routes": [{ "pattern": "cronometer.leonsilicon.ai", "custom_domain": true }],
  // The Vite build of www/ (vp build). The Worker runs first and serves a page only to browsers, as
  // @-/com.leonsilicon.www does for the TypeScript Workers.
  "assets": {
    "directory": "../../dist/www",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  // The Cronometer session key, kept between requests so the Worker doesn't sign in again.
  "kv_namespaces": [{ "binding": "SESSION", "id": "52aae9cdc5ff4f15b1e0b29f67c98d6a" }],
  // No vars here: every var and secret comes from the root .env.schema (#cronometer, values in
  // Infisical), uploaded by `varlock-wrangler deploy`, which replaces whatever the Worker had.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
