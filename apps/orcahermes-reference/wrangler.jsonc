{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "orcahermes-reference",
  "main": "worker.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": false,
  "preview_urls": false,
  "rules": [{ "type": "Text", "globs": ["**/install.py"], "fallthrough": true }],
  "routes": [
    { "pattern": "orcahermes.leonsilicon.ai", "custom_domain": true },
    { "pattern": "orcahermes-supervisor.leonsilicon.ai", "custom_domain": true },
  ],
  "assets": {
    "directory": "../../dist/www",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
}
