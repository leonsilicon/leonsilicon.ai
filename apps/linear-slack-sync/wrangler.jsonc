{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "linear-slack-sync",
  "main": "worker.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  // A Custom Domain per hostname; Cloudflare issues its certificate.
  "routes": [{ "pattern": "linear-slack.leonsilicon.ai", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "SYNC", "class_name": "SyncObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SyncObject"] }],
  // Once a day (08:00 UTC, 03:00 or 04:00 in Toronto), the safety net: repairs anything a missed webhook
  // left behind and resets every issue's timer. Times themselves go off on the Durable Object's alarm.
  "triggers": { "crons": ["0 8 * * *"] },
  // The Vite build of www/ (vp build). The Worker runs first and serves a page only to browsers; see
  // @-/ai.leonsilicon.configs.cloudflare.
  "assets": {
    "directory": "../../dist/www",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  // No vars here: every var and secret comes from the root .env.schema (#linear-slack-sync, values in
  // Infisical), uploaded by `varlock-wrangler deploy`, which replaces whatever the Worker had.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
