{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "gmail-feed",
  "main": "worker.ts",
  "compatibility_date": "2026-11-08",
  "workers_dev": false,
  "preview_urls": false,
  // A Custom Domain per hostname; Cloudflare issues its certificate.
  "routes": [{ "pattern": "gmail-feed.leonsilicon.ai", "custom_domain": true }],
  "durable_objects": { "bindings": [{ "name": "FEED", "class_name": "FeedObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FeedObject"] }],
  // Every minute: poll Gmail's history and post what arrived.
  "triggers": { "crons": ["* * * * *"] },
  // The Vite build of www/ (vp build). The Worker runs first and serves a page only to browsers; see
  // @-/ai.leonsilicon.configs.cloudflare.
  "assets": {
    "directory": "../../dist/www",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none",
  },
  // No vars here: every var and secret comes from the root .env.schema (#gmail-feed, values in
  // Infisical), uploaded by `varlock-wrangler deploy`, which replaces whatever the Worker had.
  "observability": { "enabled": true, "head_sampling_rate": 1 },
}
